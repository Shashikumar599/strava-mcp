# Copy to .env and fill in. Strava app credentials: https://www.strava.com/settings/api
STRAVA_CLIENT_ID=
STRAVA_CLIENT_SECRET=

# ---- Optional (defaults shown) ----
# Public URL of the server; every OAuth URL derives from it. On Fly: https://<app>.fly.dev
# BASE_URL=http://127.0.0.1:8000
# Where clients/tokens are stored. sqlite:///relative/to/project.db or sqlite:////absolute/path.db
# DATABASE_URL=sqlite:///store.db
# embedded = this server is the OAuth server (only implemented mode); external = Descope/Keycloak (stub)
# AUTH_MODE=embedded
# Bind address/port. 127.0.0.1 locally; the Dockerfile sets HOST=0.0.0.0 for containers.
# HOST=127.0.0.1
# PORT=8000
